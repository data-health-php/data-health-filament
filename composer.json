{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "data-health/data-health-filament",
    "description": "A Filament interface for managing Data Health findings",
    "keywords": [
        "data-health",
        "filament",
        "laravel"
    ],
    "homepage": "https://github.com/data-health-php/data-health-filament",
    "license": "MIT",
    "authors": [
        {
            "name": "Jascha Gerles",
            "email": "jg@23m.com",
            "role": "Developer"
        }
    ],
    "require": {
        "data-health/data-health": "dev-main",
        "filament/filament": "^5.0",
        "php": "^8.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0"
    },
    "autoload": {
        "psr-4": {
            "DataHealth\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DataHealth\\Filament\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../data-health",
            "options": {
                "symlink": false
            }
        }
    ],
    "scripts": {
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --no-progress --debug --memory-limit=1G",
        "test:unit": "vendor/bin/pest",
        "test": [
            "@analyse",
            "@lint:check",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "DataHealth\\Filament\\DataHealthFilamentServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
